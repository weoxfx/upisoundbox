<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:clipToPadding="false"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_total"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/surface_glass_dark"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:contentPadding="16dp"
                app:strokeColor="@color/outline_dark"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_total_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="34sp"
                        android:textColor="@color/accent_cyan"
                        android:fontFamily="sans-serif-light"
                        android:letterSpacing="-0.5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_payments"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_dark"
                        android:alpha="0.6"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.8"
                        android:textAllCaps="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_today"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/surface_glass_dark"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:contentPadding="16dp"
                app:strokeColor="@color/outline_dark"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_today_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="34sp"
                        android:textColor="@color/accent_emerald"
                        android:fontFamily="sans-serif-light"
                        android:letterSpacing="-0.5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_payments"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_dark"
                        android:alpha="0.6"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.8"
                        android:textAllCaps="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_apps_count"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/surface_glass_dark"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:contentPadding="16dp"
                app:strokeColor="@color/outline_dark"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_active_apps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="34sp"
                        android:textColor="@color/accent_violet"
                        android:fontFamily="sans-serif-light"
                        android:letterSpacing="-0.5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/active_apps"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_dark"
                        android:alpha="0.6"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.8"
                        android:textAllCaps="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textSize="13sp"
            android:textColor="@color/on_surface_dark"
            android:alpha="0.6"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true"
            android:letterSpacing="0.8"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_quick_access"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/surface_glass_dark"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:contentPadding="12dp"
                app:strokeColor="@color/outline_dark"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_notification"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="@color/accent_cyan" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Access"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_dark"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        android:letterSpacing="0.5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_quick_apps"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/surface_glass_dark"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:contentPadding="12dp"
                app:strokeColor="@color/outline_dark"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_apps"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="@color/accent_violet" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apps"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_dark"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        android:letterSpacing="0.5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_quick_history"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@color/surface_glass_dark"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:contentPadding="12dp"
                app:strokeColor="@color/outline_dark"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_history"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="@color/accent_emerald" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="History"
                        android:textSize="11sp"
                        android:textColor="@color/on_surface_dark"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="true"
                        android:letterSpacing="0.5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_glass_dark"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:contentPadding="16dp"
            app:strokeColor="@color/outline_dark"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/status_dot"
                    android:layerType="software" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_status_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/listening_for_payments"
                        android:textSize="15sp"
                        android:textColor="@color/on_surface_dark"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_status_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_dark"
                        android:alpha="0.5"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_alert"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/send_test_alert"
                    android:textSize="12sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:backgroundTint="@color/primary_40"
                    android:letterSpacing="0.3" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_glass_dark"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:contentPadding="16dp"
            app:strokeColor="@color/outline_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Activity"
                    android:textSize="17sp"
                    android:textColor="@color/on_surface_dark"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.2"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:id="@+id/layout_recent_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:minHeight="100dp">

                    <TextView
                        android:id="@+id/tv_no_payments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_payments"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface_dark"
                        android:alpha="0.4"
                        android:fontFamily="sans-serif"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tv_no_payments_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payments_will_appear"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_dark"
                        android:alpha="0.25"
                        android:fontFamily="sans-serif"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
